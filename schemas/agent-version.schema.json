{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentVersion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agentId",
    "version",
    "runtimeType",
    "hostingMode",
    "modelProfile",
    "inputSchemaRef",
    "outputSchemaRef"
  ],
  "properties": {
    "agentId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "runtimeType": {
      "enum": [
        "CONFIG",
        "EMBABEL",
        "REMOTE_HTTP",
        "REMOTE_A2A"
      ]
    },
    "hostingMode": {
      "enum": [
        "PLATFORM",
        "CLIENT",
        "EXTERNAL"
      ]
    },
    "artifactRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "remoteEndpointRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilitiesProvided": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "toolCapabilitiesRequired": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "agentCapabilitiesRequired": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "modelProfile": {
      "type": "string"
    },
    "promptRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputSchemaRef": {
      "type": "string"
    },
    "outputSchemaRef": {
      "type": "string"
    },
    "executionPolicyRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "securityPolicyRef": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}